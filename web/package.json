{
  "name": "aibo-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tutorial && bun ./node_modules/vite/bin/vite.js",
    "build": "bun run tutorial && bun ./node_modules/typescript/lib/tsc.js -b && bun ./node_modules/vite/bin/vite.js build",
    "lint": "bun run tutorial && bun ./node_modules/eslint/bin/eslint.js .",
    "test": "bun run tutorial && bun test tests",
    "check": "bun run format:check && bun run lint && bun run test && bun run build",
    "tutorial": "bun scripts/build-tutorial.mjs",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs --write \"src/**/*.{ts,tsx}\" \"tests/*.mjs\" \"scripts/*.mjs\" \"*.{js,ts,json}\" \"../.github/workflows/*.{yml,yaml}\"",
    "format:check": "bun ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx}\" \"tests/*.mjs\" \"scripts/*.mjs\" \"*.{js,ts,json}\" \"../.github/workflows/*.{yml,yaml}\""
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
